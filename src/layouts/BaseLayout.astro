---
import '../styles/global.css';
import ChromaticSubstrate from '../components/ChromaticSubstrate.astro';
import LiquidGlassFilter from '../components/LiquidGlassFilter.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { isZhLocale } from '../utils/locale';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  lang?: string;
}

const isZh = isZhLocale(Astro.url.pathname);

const {
  title = 'Hello, Im DeepJH.',
  description = "DeepJH's personal engineering showcase and technical publication platform featuring curated projects, deep case studies, and systems architecture essays.",
  image = '/og-image.png',
  article = false,
  lang = isZh ? 'zh' : 'en',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://hereisdeepjh.dpdns.org');
const formattedTitle = title.includes('DeepJH') ? title : `${title} — DeepJH`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="DeepJH Posts RSS Feed" href="/rss.xml" />

    <title>{formattedTitle}</title>
    <meta name="title" content={formattedTitle} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={formattedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />
    <meta property="og:site_name" content="DeepJH" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={formattedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, canonicalURL)} />

    <!-- Zero-FOUC Inline Theme Script -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          if (
            stored === 'dark' ||
            (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)
          ) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body
    class="relative flex min-h-screen flex-col bg-slate-50 text-zinc-800 transition-colors duration-300 selection:bg-sky-500/20 selection:text-sky-900 dark:bg-zinc-950 dark:text-zinc-100 dark:selection:text-sky-200"
  >
    <ChromaticSubstrate />
    <LiquidGlassFilter />
    <Header currentPath={Astro.url.pathname} />

    <main class="mx-auto w-full max-w-5xl flex-1 px-4 pt-10 pb-16 sm:px-6">
      <slot />
    </main>

    <Footer />
  </body>
</html>
