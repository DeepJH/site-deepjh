---
import BaseLayout from '../layouts/BaseLayout.astro';
import LiquidGlass from '../components/LiquidGlass.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getFeaturedProjects, getPublishedPosts } from '../utils/content';

const featuredProjects = await getFeaturedProjects();
const allPosts = await getPublishedPosts();
const recentPosts = allPosts.slice(0, 3);

const engineeringPrinciples = [
  {
    title: 'Autonomous Workflows',
    description:
      'Designing self-contained agent pipelines with multi-tier verification seams, deterministic execution boundaries, and rigorous feedback loops.',
  },
  {
    title: 'Tactile Craft',
    description:
      'Pursuing Apple-grade tactile feedback, crystalline liquid glass optics, fluid physics, and zero-compromise typography across every interface.',
  },
  {
    title: 'Lean & Local-First',
    description:
      'Static-first pre-rendered architectures, minimal runtime JS footprints, and resilient local data sovereignty without speculative cloud bloat.',
  },
];
---

<BaseLayout
  title="Hello, Im DeepJH."
  description="DeepJH's personal engineering showcase and technical publication platform featuring curated projects, deep case studies, and systems architecture essays."
>
  <!-- Hero Section -->
  <section class="py-10 sm:py-16">
    <LiquidGlass class="p-8 sm:p-12">
      <div class="flex flex-col-reverse items-start justify-between gap-8 sm:flex-row sm:items-center">
        <div class="flex-1">
          <div
            class="inline-flex items-center gap-2 rounded-full border border-sky-400/30 bg-sky-50/80 px-3.5 py-1 text-xs font-semibold text-sky-700 backdrop-blur-sm dark:border-sky-500/20 dark:bg-sky-950/40 dark:text-sky-300"
          >
            <span class="h-2 w-2 animate-pulse rounded-full bg-sky-500"></span>
            AI Agents & Full-Stack Systems
          </div>

          <h1
            class="mt-6 text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-5xl sm:leading-tight dark:text-zinc-50"
          >
            Engineering autonomous agent workflows & high-craft full-stack web architectures.
          </h1>

          <p class="mt-4 max-w-2xl text-base leading-relaxed text-zinc-600 sm:text-lg dark:text-zinc-300">
            I am <span class="font-semibold text-zinc-900 dark:text-zinc-100">DeepJH</span>. I build autonomous developer agents, high-performance engines, and tactile web applications focused on local-first resilience and aesthetic clarity.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href="/projects"
              class="liquid-glass-interactive inline-flex items-center justify-center rounded-full bg-zinc-900 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-white"
            >
              Explore Showcase ({featuredProjects.length})
            </a>
            <a
              href="/posts"
              class="liquid-glass-interactive inline-flex items-center justify-center rounded-full border border-zinc-300/80 bg-white/60 px-6 py-2.5 text-sm font-semibold text-zinc-700 backdrop-blur-sm hover:bg-white dark:border-zinc-700/80 dark:bg-zinc-800/60 dark:text-zinc-200 dark:hover:bg-zinc-800"
            >
              Read Publications
            </a>
          </div>
        </div>

        <!-- Hero Avatar -->
        <div class="relative shrink-0">
          <div class="absolute -inset-1.5 rounded-full bg-gradient-to-tr from-sky-400 to-indigo-500 opacity-60 blur-md transition duration-500 group-hover:opacity-100"></div>
          <img
            src="/avatar.png"
            alt="DeepJH Profile Avatar"
            class="relative h-28 w-28 rounded-full border-2 border-white object-cover shadow-xl sm:h-36 sm:w-36 dark:border-zinc-800"
          />
        </div>
      </div>
    </LiquidGlass>
  </section>

  <!-- Curated Showcase Section (2x2 Grid) -->
  <section id="showcase" class="py-10">
    <div class="flex items-center justify-between pb-6">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
          Curated Showcase
        </h2>
        <p class="text-sm text-zinc-500 dark:text-zinc-400">
          Four flagship engineering projects with architectural breakdowns & quantified outcomes.
        </p>
      </div>
      <a
        href="/projects"
        class="text-sm font-semibold text-sky-600 hover:text-sky-700 dark:text-sky-400 dark:hover:text-sky-300"
      >
        View all projects &rarr;
      </a>
    </div>

    <!-- 2x2 Grid -->
    <div id="showcase-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-2">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <!-- Core Engineering Principles Section -->
  <section id="principles" class="py-10">
    <div class="pb-6">
      <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
        Engineering Principles
      </h2>
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        The core technical philosophy behind my architectures, systems, and design choices.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
      {
        engineeringPrinciples.map((principle, idx) => (
          <LiquidGlass class="p-6">
            <div class="text-xs font-mono font-bold text-sky-600 dark:text-sky-400">
              0{idx + 1}
            </div>
            <h3 class="mt-2 text-base font-bold text-zinc-900 dark:text-zinc-100">
              {principle.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
              {principle.description}
            </p>
          </LiquidGlass>
        ))
      }
    </div>
  </section>

  <!-- Recent Posts Section & Digital Garden -->
  <section id="posts" class="py-10">
    <div class="flex items-center justify-between pb-6">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
          Publications & Digital Garden
        </h2>
        <p class="text-sm text-zinc-500 dark:text-zinc-400">
          Long-form essays syndicated from my live knowledge base at <a href="https://github.com/DeepJH/text-note" target="_blank" rel="noopener noreferrer" class="font-medium text-sky-600 hover:underline dark:text-sky-400">DeepJH/text-note</a>.
        </p>
      </div>
      <a
        href="/posts"
        class="text-sm font-semibold text-sky-600 hover:text-sky-700 dark:text-sky-400 dark:hover:text-sky-300"
      >
        View all articles &rarr;
      </a>
    </div>

    <div id="posts-list" class="space-y-4">
      {
        recentPosts.map((post) => (
          <LiquidGlass
            as="article"
            hoverGlow={true}
            class="flex flex-col justify-between gap-4 p-5 sm:flex-row sm:items-center sm:p-6"
          >
            <div>
              <div class="flex items-center gap-2 text-xs text-zinc-500 dark:text-zinc-400">
                <time datetime={post.data.publishDate.toISOString()}>
                  {post.data.publishDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
                {post.data.readingTime && (
                  <>
                    <span>&bull;</span>
                    <span>{post.data.readingTime}</span>
                  </>
                )}
              </div>
              <h3 class="mt-1 text-base font-bold text-zinc-900 hover:text-sky-600 dark:text-zinc-100 dark:hover:text-sky-400">
                <a href={`/posts/${post.id}`}>{post.data.title}</a>
              </h3>
              <p class="mt-1 line-clamp-2 text-sm text-zinc-600 dark:text-zinc-300">
                {post.data.description}
              </p>
            </div>
            <a
              href={`/posts/${post.id}`}
              class="shrink-0 text-sm font-semibold text-sky-600 hover:underline dark:text-sky-400"
            >
              Read post &rarr;
            </a>
          </LiquidGlass>
        ))
      }
    </div>
  </section>
</BaseLayout>
