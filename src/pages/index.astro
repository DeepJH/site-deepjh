---
import BaseLayout from '../layouts/BaseLayout.astro';
import LiquidGlass from '../components/LiquidGlass.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getFeaturedProjects, getPublishedPosts } from '../utils/content';

const featuredProjects = await getFeaturedProjects();
const allPosts = await getPublishedPosts();
const recentPosts = allPosts.slice(0, 3);

const engineeringPrinciples = [
  {
    title: 'Zero-Runtime Baseline',
    description:
      'Content sites should produce pre-rendered, static edge assets. JavaScript is an enhancement reserved strictly for necessary client interactions.',
  },
  {
    title: 'Hardware & Kernel Symbiosis',
    description:
      'Deep performance engineering requires designing with cache hierarchies, SIMD instruction sets, and modern kernel bypass primitives (io_uring, eBPF).',
  },
  {
    title: 'Pragmatic Systems Craft',
    description:
      'Avoid speculative abstractions and over-engineering. Favor simple, deep modules with rock-solid invariants and empirical benchmark validations.',
  },
];
---

<BaseLayout
  title="DeepJH — Personal Engineering Showcase"
  description="Personal engineering portfolio and technical publication platform featuring curated projects, deep case studies, and systems architecture essays."
>
  <!-- Hero Section -->
  <section class="py-12 sm:py-16">
    <LiquidGlass class="p-8 sm:p-12">
      <div
        class="inline-flex items-center gap-2 rounded-full border border-sky-400/30 bg-sky-50/80 px-3 py-1 text-xs font-semibold text-sky-700 backdrop-blur-sm dark:border-sky-500/20 dark:bg-sky-950/40 dark:text-sky-300"
      >
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-sky-500"></span>
        Systems & Technical Architecture
      </div>

      <h1
        class="mt-6 text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-5xl sm:leading-tight dark:text-zinc-50"
      >
        Crafting high-scale systems with architectural rigor & aesthetic precision.
      </h1>

      <p class="mt-4 max-w-2xl text-base leading-relaxed text-zinc-600 sm:text-lg dark:text-zinc-300">
        I am <span class="font-semibold text-zinc-900 dark:text-zinc-100">DeepJH</span>, a software
        engineer and systems architect focused on distributed storage, kernel networking, and
        zero-overhead static architecture.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="/projects"
          class="inline-flex items-center justify-center rounded-xl bg-zinc-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-white"
        >
          Explore Showcase ({featuredProjects.length})
        </a>
        <a
          href="/posts"
          class="inline-flex items-center justify-center rounded-xl border border-zinc-300/80 bg-white/60 px-5 py-2.5 text-sm font-semibold text-zinc-700 backdrop-blur-sm transition-all hover:bg-white dark:border-zinc-700/80 dark:bg-zinc-800/60 dark:text-zinc-200 dark:hover:bg-zinc-800"
        >
          Read Technical Posts
        </a>
      </div>
    </LiquidGlass>
  </section>

  <!-- Curated Showcase Section -->
  <section id="showcase" class="py-10">
    <div class="flex items-center justify-between pb-6">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
          Curated Showcase
        </h2>
        <p class="text-sm text-zinc-500 dark:text-zinc-400">
          Flagship engineering initiatives with architecture breakdowns & quantified outcomes.
        </p>
      </div>
      <a
        href="/projects"
        class="text-sm font-semibold text-sky-600 hover:text-sky-700 dark:text-sky-400 dark:hover:text-sky-300"
      >
        View all projects &rarr;
      </a>
    </div>

    <div id="showcase-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <!-- Core Engineering Principles Section -->
  <section id="principles" class="py-10">
    <div class="pb-6">
      <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
        Engineering Principles
      </h2>
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        The core technical philosophy behind my architectures, systems, and design choices.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
      {
        engineeringPrinciples.map((principle, idx) => (
          <LiquidGlass class="p-6">
            <div class="text-xs font-mono font-bold text-sky-600 dark:text-sky-400">
              0{idx + 1}
            </div>
            <h3 class="mt-2 text-base font-bold text-zinc-900 dark:text-zinc-100">
              {principle.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
              {principle.description}
            </p>
          </LiquidGlass>
        ))
      }
    </div>
  </section>

  <!-- Recent Posts Section -->
  <section id="posts" class="py-10">
    <div class="flex items-center justify-between pb-6">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
          Recent Publications
        </h2>
        <p class="text-sm text-zinc-500 dark:text-zinc-400">
          Deep-dive technical articles, systems tutorials, and architectural trade-offs.
        </p>
      </div>
      <a
        href="/posts"
        class="text-sm font-semibold text-sky-600 hover:text-sky-700 dark:text-sky-400 dark:hover:text-sky-300"
      >
        View all articles &rarr;
      </a>
    </div>

    <div id="posts-list" class="space-y-4">
      {
        recentPosts.map((post) => (
          <LiquidGlass
            as="article"
            hoverGlow={true}
            class="flex flex-col justify-between gap-4 p-5 sm:flex-row sm:items-center sm:p-6"
          >
            <div>
              <div class="flex items-center gap-2 text-xs text-zinc-500 dark:text-zinc-400">
                <time datetime={post.data.publishDate.toISOString()}>
                  {post.data.publishDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
                {post.data.readingTime && (
                  <>
                    <span>&bull;</span>
                    <span>{post.data.readingTime}</span>
                  </>
                )}
              </div>
              <h3 class="mt-1 text-base font-bold text-zinc-900 hover:text-sky-600 dark:text-zinc-100 dark:hover:text-sky-400">
                <a href={`/posts/${post.id}`}>{post.data.title}</a>
              </h3>
              <p class="mt-1 line-clamp-2 text-sm text-zinc-600 dark:text-zinc-300">
                {post.data.description}
              </p>
            </div>
            <a
              href={`/posts/${post.id}`}
              class="shrink-0 text-sm font-semibold text-sky-600 hover:underline dark:text-sky-400"
            >
              Read post &rarr;
            </a>
          </LiquidGlass>
        ))
      }
    </div>
  </section>
</BaseLayout>
