---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getPublishedProjects } from '../../utils/content';

const sortedProjects = await getPublishedProjects();
---

<BaseLayout
  title="Projects — Engineering Showcase"
  description="Comprehensive catalog of DeepJH's engineering systems, distributed architectures, and open-source infrastructure projects."
>
  <header class="py-8 sm:py-12">
    <div
      class="inline-flex items-center gap-2 rounded-full border border-sky-400/30 bg-sky-50/80 px-3 py-1 text-xs font-semibold text-sky-700 backdrop-blur-sm dark:border-sky-500/20 dark:bg-sky-950/40 dark:text-sky-300"
    >
      Case Studies & Systems
    </div>
    <h1
      class="mt-4 text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-50"
    >
      Engineering Projects
    </h1>
    <p class="mt-3 max-w-2xl text-base text-zinc-600 dark:text-zinc-300">
      A curated collection of flagship engineering initiatives. Each project features deep
      architectural analysis, engineering trade-offs, and empirical benchmarks.
    </p>
  </header>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    {sortedProjects.map((project) => <ProjectCard project={project} />)}
  </div>
</BaseLayout>
