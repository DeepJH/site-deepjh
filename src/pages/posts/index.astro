---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LiquidGlass from '../../components/LiquidGlass.astro';
import { getPublishedPosts } from '../../utils/content';

const publishedPosts = await getPublishedPosts();

// Extract unique tags sorted alphabetically
const allTags = Array.from(
  new Set(publishedPosts.flatMap((post) => post.data.tags))
).sort();
---

<BaseLayout
  title="Technical Publications"
  description="In-depth technical publications, systems architecture deep dives, kernel networking, and distributed systems tutorials."
>
  <header class="py-8 sm:py-12">
    <div
      class="inline-flex items-center gap-2 rounded-full border border-sky-400/30 bg-sky-50/80 px-3 py-1 text-xs font-semibold text-sky-700 backdrop-blur-sm dark:border-sky-500/20 dark:bg-sky-950/40 dark:text-sky-300"
    >
      Writing & Essays
    </div>
    <h1
      class="mt-4 text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-50"
    >
      Technical Publications
    </h1>
    <p class="mt-3 max-w-2xl text-base text-zinc-600 dark:text-zinc-300">
      Code-level technical essays and system engineering tutorials. Written with rigorous
      typographic rhythm, build-time syntax highlighting, and zero client-side JavaScript overhead.
    </p>

    <!-- Tag Filter Badges -->
    <div class="mt-8 flex flex-wrap items-center gap-2" id="tag-filters">
      <button
        type="button"
        data-filter="all"
        class="tag-filter-btn rounded-xl border border-sky-400/40 bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-700 transition-all dark:border-sky-500/30 dark:bg-sky-950/50 dark:text-sky-300"
      >
        All ({publishedPosts.length})
      </button>
      {
        allTags.map((tag) => {
          const count = publishedPosts.filter((p) => p.data.tags.includes(tag)).length;
          return (
            <button
              type="button"
              data-filter={tag}
              class="tag-filter-btn rounded-xl border border-zinc-200/80 bg-white/60 px-3 py-1 text-xs font-medium text-zinc-600 transition-all hover:border-zinc-300 hover:text-zinc-900 dark:border-zinc-700/80 dark:bg-zinc-800/60 dark:text-zinc-400 dark:hover:text-zinc-100"
            >
              {tag} ({count})
            </button>
          );
        })
      }
    </div>
  </header>

  <div class="space-y-6" id="posts-container">
    {
      publishedPosts.map((post) => (
        <LiquidGlass
          as="article"
          hoverGlow={true}
          class="p-6 sm:p-8"
          data-post-item="true"
          data-tags={post.data.tags.join(',')}
        >
          <div class="flex flex-wrap items-center gap-3 text-xs text-zinc-500 dark:text-zinc-400">
            <time datetime={post.data.publishDate.toISOString()}>
              {post.data.publishDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              })}
            </time>
            {post.data.readingTime && (
              <>
                <span>&bull;</span>
                <span data-reading-time="true">{post.data.readingTime}</span>
              </>
            )}
          </div>

          <h2 class="mt-3 text-xl font-bold tracking-tight text-zinc-900 group-hover:text-sky-600 dark:text-zinc-50 dark:group-hover:text-sky-400">
            <a
              href={`/posts/${post.id}`}
              data-post-link="true"
              class="hover:underline focus:outline-none"
            >
              {post.data.title}
            </a>
          </h2>

          <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
            {post.data.description}
          </p>

          <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-zinc-200/60 pt-4 dark:border-zinc-800/80">
            <div class="flex flex-wrap gap-1.5">
              {post.data.tags.map((tag) => (
                <span class="rounded-md border border-zinc-200/80 bg-zinc-100/70 px-2 py-0.5 text-xs font-medium text-zinc-700 dark:border-zinc-700/60 dark:bg-zinc-800/60 dark:text-zinc-300">
                  {tag}
                </span>
              ))}
            </div>

            <a
              href={`/posts/${post.id}`}
              data-post-link="true"
              class="text-xs font-semibold text-sky-600 hover:text-sky-700 dark:text-sky-400 dark:hover:text-sky-300"
            >
              Read full article &rarr;
            </a>
          </div>
        </LiquidGlass>
      ))
    }
  </div>

  <script is:inline>
    (function () {
      const buttons = document.querySelectorAll('.tag-filter-btn');
      const posts = document.querySelectorAll('[data-post-item="true"]');

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter');

          buttons.forEach((b) => {
            b.classList.remove(
              'border-sky-400/40',
              'bg-sky-50',
              'text-sky-700',
              'dark:border-sky-500/30',
              'dark:bg-sky-950/50',
              'dark:text-sky-300',
              'font-semibold'
            );
            b.classList.add(
              'border-zinc-200/80',
              'bg-white/60',
              'text-zinc-600',
              'dark:border-zinc-700/80',
              'dark:bg-zinc-800/60',
              'dark:text-zinc-400',
              'font-medium'
            );
          });

          btn.classList.add(
            'border-sky-400/40',
            'bg-sky-50',
            'text-sky-700',
            'dark:border-sky-500/30',
            'dark:bg-sky-950/50',
            'dark:text-sky-300',
            'font-semibold'
          );

          posts.forEach((post) => {
            if (filter === 'all') {
              post.classList.remove('hidden');
            } else {
              const tags = (post.getAttribute('data-tags') || '').split(',');
              if (tags.includes(filter)) {
                post.classList.remove('hidden');
              } else {
                post.classList.add('hidden');
              }
            }
          });
        });
      });
    })();
  </script>
</BaseLayout>
