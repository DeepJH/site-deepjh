---
import BaseLayout from '../layouts/BaseLayout.astro';
import LiquidGlass from '../components/LiquidGlass.astro';
---

<BaseLayout
  title="404 — Page Not Found"
  description="The requested page could not be located."
>
  <div class="flex min-h-[60vh] flex-col items-center justify-center py-12 text-center">
    <LiquidGlass class="max-w-md p-8 sm:p-12">
      <div
        class="inline-flex items-center gap-2 rounded-full border border-rose-400/30 bg-rose-50/80 px-3 py-1 text-xs font-semibold text-rose-700 backdrop-blur-sm dark:border-rose-500/20 dark:bg-rose-950/40 dark:text-rose-300"
      >
        HTTP 404
      </div>

      <h1
        class="mt-4 text-4xl font-extrabold tracking-tight text-zinc-900 sm:text-6xl dark:text-zinc-50"
      >
        404
      </h1>

      <p class="mt-4 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
        The page you are looking for does not exist or has been relocated to another path.
      </p>

      <div class="mt-8">
        <a
          href="/"
          class="liquid-glass-interactive inline-flex items-center justify-center rounded-full bg-zinc-900 px-6 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-white"
        >
          &larr; Back to Homepage
        </a>
      </div>
    </LiquidGlass>
  </div>
</BaseLayout>
