---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LiquidGlass from '../../../components/LiquidGlass.astro';
import { render } from 'astro:content';
import { getPublishedProjects } from '../../../utils/content';

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const {
  title,
  description,
  tags,
  coverImage,
  repoUrl,
  demoUrl,
  role,
  timeline,
  metrics,
  publishDate,
} = project.data;
const { Content } = await render(project);
---

<BaseLayout title={title} description={description} lang="zh">
  <div class="py-6 sm:py-10">
    <!-- Back to projects -->
    <a
      href="/zh/projects"
      class="inline-flex items-center gap-1.5 text-sm font-semibold text-zinc-500 transition-colors hover:text-sky-600 dark:text-zinc-400 dark:hover:text-sky-400"
    >
      &larr; 返回项目列表
    </a>

    <!-- Case Study Header -->
    <header class="mt-6">
      <div class="flex flex-wrap gap-2">
        {
          tags.map((tag) => (
            <span class="rounded-full border border-sky-200/80 bg-sky-50/70 px-3 py-1 text-xs font-semibold text-sky-800 backdrop-blur-sm dark:border-sky-900/60 dark:bg-sky-950/40 dark:text-sky-300">
              {tag}
            </span>
          ))
        }
      </div>

      <h1
        class="mt-4 text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-5xl dark:text-zinc-50"
      >
        {title}
      </h1>

      <p class="mt-4 text-lg leading-relaxed text-zinc-600 dark:text-zinc-300">
        {description}
      </p>

      {
        coverImage && (
          <div class="mt-8 overflow-hidden rounded-2xl border border-zinc-200/80 shadow-md dark:border-zinc-800">
            <img
              src={coverImage}
              alt={`${title} 架构示意图`}
              class="h-72 w-full object-cover sm:h-96"
            />
          </div>
        )
      }
    </header>

    <!-- Structured Metadata & Links -->
    <LiquidGlass class="mt-8 p-6 sm:p-8" data-case-study-meta="true">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-3 sm:items-center">
        <!-- Role & Timeline -->
        <div>
          <div class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
            角色与周期
          </div>
          <div class="mt-1 text-sm font-bold text-zinc-800 dark:text-zinc-100">
            {role || '系统架构师'}
          </div>
          <div class="text-xs text-zinc-500 dark:text-zinc-400">
            {timeline || '2025'} &bull; 发布于 {
              publishDate.toLocaleDateString('zh-CN', {
                year: 'numeric',
                month: 'short',
              })
            }
          </div>
        </div>

        <!-- Complete Primary Tech Stack (Non-truncated) -->
        <div>
          <div class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
            技术栈
          </div>
          <div class="mt-1 flex flex-wrap gap-1 text-xs text-zinc-700 dark:text-zinc-300">
            {tags.join(' • ')}
          </div>
        </div>

        <!-- Verified Implementation Links -->
        <div class="flex flex-wrap items-center gap-3 sm:justify-end">
          {
            repoUrl && (
              <a
                href={repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="liquid-glass-interactive inline-flex items-center gap-2 rounded-full border border-zinc-300/80 bg-white/70 px-4 py-2 text-xs font-semibold text-zinc-800 shadow-sm backdrop-blur-sm transition-all hover:bg-white dark:border-zinc-700 dark:bg-zinc-800/70 dark:text-zinc-200 dark:hover:bg-zinc-800"
              >
                源码 &rarr;
              </a>
            )
          }
          {
            demoUrl && (
              <a
                href={demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="liquid-glass-interactive inline-flex items-center gap-2 rounded-full bg-sky-600 px-4 py-2 text-xs font-semibold text-white shadow-sm transition-all hover:bg-sky-700 dark:bg-sky-500 dark:hover:bg-sky-600"
              >
                在线体验 &rarr;
              </a>
            )
          }
        </div>
      </div>

      <!-- Metrics Panel -->
      {
        metrics && metrics.length > 0 && (
          <div
            class="mt-6 border-t border-zinc-200/60 pt-6 dark:border-zinc-800/80"
            data-case-study-metrics="true"
          >
            <div class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
              实证基准与关键成效
            </div>
            <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
              {metrics.map((metric) => (
                <div class="rounded-xl border border-sky-200/60 bg-sky-50/60 p-3 text-center backdrop-blur-sm dark:border-sky-900/40 dark:bg-sky-950/30">
                  <div class="text-xs font-medium text-sky-800 dark:text-sky-300">
                    {metric.label}
                  </div>
                  <div class="mt-1 text-base font-extrabold text-sky-950 dark:text-sky-200">
                    {metric.value}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )
      }
    </LiquidGlass>

    <!-- Markdown Case Study Prose -->
    <div
      class="prose prose-zinc mt-12 max-w-none dark:prose-invert prose-headings:scroll-mt-24 prose-headings:font-bold prose-headings:tracking-tight prose-a:text-sky-600 hover:prose-a:underline prose-pre:rounded-2xl prose-pre:border prose-pre:border-zinc-200/80 prose-pre:shadow-sm dark:prose-pre:border-zinc-800 dark:prose-a:text-sky-400"
      data-case-study-content="true"
    >
      <Content />
    </div>
  </div>
</BaseLayout>
