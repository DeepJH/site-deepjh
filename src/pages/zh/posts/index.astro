---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LiquidGlass from '../../../components/LiquidGlass.astro';
import { getPublishedPosts } from '../../../utils/content';

const publishedPosts = await getPublishedPosts();

const allTags = Array.from(
  new Set(publishedPosts.flatMap((post) => post.data.tags))
).sort();
---

<BaseLayout
  title="技术文章 — 个人知识库"
  description="深度技术文章、智能体架构、博弈引擎与系统工程文章。"
  lang="zh"
>
  <header class="py-8 sm:py-12">
    <div
      class="inline-flex items-center gap-2 rounded-full border border-sky-400/30 bg-sky-50/80 px-3 py-1 text-xs font-semibold text-sky-700 backdrop-blur-sm dark:border-sky-500/20 dark:bg-sky-950/40 dark:text-sky-300"
    >
      文章与深度思考
    </div>
    <h1
      class="mt-4 text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-50"
    >
      技术文章与知识花园
    </h1>
    <p class="mt-3 max-w-2xl text-base text-zinc-600 dark:text-zinc-300">
      聚焦架构本质、智能体协同设计与工程系统构建。纯静态编译期渲染，零客户端 JS 运行时开销。
    </p>

    <!-- Digital Garden Callout Banner -->
    <div class="mt-6">
      <LiquidGlass variant="bar" class="flex flex-col sm:flex-row items-center justify-between gap-3 px-5 py-3">
        <div class="flex items-center gap-2.5 text-xs text-zinc-600 dark:text-zinc-300">
          <span class="inline-block h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>现场数字花园与日常未编辑笔记库：</span>
          <span class="font-semibold text-zinc-900 dark:text-zinc-100">DeepJH/text-note</span>
        </div>
        <a
          href="https://github.com/DeepJH/text-note"
          target="_blank"
          rel="noopener noreferrer"
          class="liquid-glass-interactive inline-flex items-center gap-1.5 rounded-full bg-zinc-900 px-3.5 py-1 text-xs font-semibold text-white hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-white"
        >
          在 GitHub 探索 &rarr;
        </a>
      </LiquidGlass>
    </div>

    <!-- Tag Filter Links -->
    <div class="mt-6 flex flex-wrap items-center gap-2" id="tag-filters">
      <a
        href="/zh/posts"
        data-filter="all"
        class="rounded-full border border-sky-400/40 bg-sky-50 px-3.5 py-1 text-xs font-semibold text-sky-700 transition-all dark:border-sky-500/30 dark:bg-sky-950/50 dark:text-sky-300"
      >
        全部 ({publishedPosts.length})
      </a>
      {
        allTags.map((tag) => {
          const count = publishedPosts.filter((p) => p.data.tags.includes(tag)).length;
          return (
            <span
              class="rounded-full border border-zinc-200/80 bg-white/60 px-3 py-1 text-xs font-medium text-zinc-600 dark:border-zinc-700/80 dark:bg-zinc-800/60 dark:text-zinc-400"
            >
              {tag} ({count})
            </span>
          );
        })
      }
    </div>
  </header>

  <div class="space-y-6" id="posts-container">
    {
      publishedPosts.map((post) => (
        <LiquidGlass
          as="article"
          hoverGlow={true}
          class="p-6 sm:p-8"
          data-post-item="true"
        >
          <div class="flex flex-wrap items-center gap-3 text-xs text-zinc-500 dark:text-zinc-400">
            <time datetime={post.data.publishDate.toISOString()}>
              {post.data.publishDate.toLocaleDateString('zh-CN', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              })}
            </time>
            {post.data.readingTime && (
              <>
                <span>&bull;</span>
                <span data-reading-time="true">{post.data.readingTime}</span>
              </>
            )}
          </div>

          <h2 class="mt-3 text-xl font-bold tracking-tight text-zinc-900 group-hover:text-sky-600 dark:text-zinc-50 dark:group-hover:text-sky-400">
            <a
              href={`/zh/posts/${post.id}`}
              data-post-link="true"
              class="hover:underline focus:outline-none"
            >
              {post.data.title}
            </a>
          </h2>

          <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
            {post.data.description}
          </p>

          <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-zinc-200/60 pt-4 dark:border-zinc-800/80">
            <div class="flex flex-wrap gap-1.5">
              {post.data.tags.map((tag) => (
                <span
                  class="rounded-full border border-zinc-200/80 bg-zinc-100/70 px-2.5 py-0.5 text-xs font-medium text-zinc-700 dark:border-zinc-700/60 dark:bg-zinc-800/60 dark:text-zinc-300"
                >
                  {tag}
                </span>
              ))}
            </div>

            <a
              href={`/zh/posts/${post.id}`}
              data-post-link="true"
              class="text-xs font-semibold text-sky-600 hover:text-sky-700 dark:text-sky-400 dark:hover:text-sky-300"
            >
              阅读完整文章 &rarr;
            </a>
          </div>
        </LiquidGlass>
      ))
    }
  </div>
</BaseLayout>
