---
interface Props {
  as?: 'div' | 'section' | 'article' | 'nav';
  class?: string;
  hoverGlow?: boolean;
  pill?: boolean;
}

const {
  as: Component = 'div',
  class: className = '',
  hoverGlow = false,
  pill = false,
  ...rest
} = Astro.props;
---

<Component
  class:list={[
    'relative backdrop-blur-[9px]',
    pill ? 'rounded-full' : 'rounded-2xl',
    'bg-white/35 dark:bg-zinc-900/40',
    'border border-white/70 dark:border-white/10',
    'shadow-[0_4px_24px_rgba(0,0,0,0.03)] dark:shadow-[0_4px_24px_rgba(0,0,0,0.25)]',
    'transition-all duration-300',
    hoverGlow &&
      'hover:shadow-[0_8px_30px_rgba(56,189,248,0.14)] hover:border-sky-300/60 dark:hover:border-sky-500/30',
    className,
  ]}
  {...rest}
>
  <slot />
</Component>
