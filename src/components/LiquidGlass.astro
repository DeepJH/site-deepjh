---
// Authentic Liquid Glass Component (Ported from rdev/liquid-glass-react architecture per ADR 0005, 0007, 0008)
// Decouples the optical background warp layer (.glass__warp / .glass-card) from foreground child content (.glass__content).

interface Props {
  as?: 'div' | 'section' | 'article' | 'nav' | 'header';
  variant?: 'card' | 'pill' | 'bar';
  pill?: boolean; // backwards compatibility
  isBar?: boolean; // backwards compatibility
  class?: string;
  contentClass?: string;
  hoverGlow?: boolean;
  id?: string;
  'data-case-study-meta'?: string;
}

const {
  as: Component = 'div',
  variant,
  pill = false,
  isBar = false,
  class: className = '',
  contentClass = '',
  hoverGlow = false,
  ...rest
} = Astro.props;

// Morphology hierarchy: 'bar' (wide nav/banner), 'pill' (compact 1:1~3:1 refraction capsule), 'card' (2.5D elevation card)
const resolvedVariant: 'card' | 'pill' | 'bar' =
  variant ?? (isBar || Component === 'nav' ? 'bar' : pill ? 'pill' : 'card');

const isPill = resolvedVariant === 'pill';
const isBarVariant = resolvedVariant === 'bar';
---

<Component
  class:list={[
    'relative isolate group/glass',
    isPill || isBarVariant ? 'rounded-full' : 'rounded-2xl',
    className,
  ]}
  {...rest}
>
  <!-- Optical Background Layer: compact pills receive liquid refraction filter, wide bars & cards receive crystal backdrop blur -->
  <span
    aria-hidden="true"
    class:list={[
      'pointer-events-none absolute inset-0 -z-10 overflow-hidden',
      isPill
        ? 'glass__warp rounded-full'
        : isBarVariant
          ? 'glass-card rounded-full'
          : 'glass-card rounded-2xl',
      // Authentic zero-tint transparent base (100% optical refraction without milky acrylic wash)
      'bg-transparent',
      // Specular rim border
      'border border-white/50 dark:border-white/15',
      // Official rdev physical floating elevation shadow + multi-bevel specular inset highlights
      'shadow-[0_12px_40px_rgba(0,0,0,0.12),inset_0_1px_1px_0_rgba(255,255,255,0.7),inset_0_0_0_0.5px_rgba(255,255,255,0.4)]',
      'dark:shadow-[0_16px_50px_rgba(0,0,0,0.55),inset_0_1px_1px_0_rgba(255,255,255,0.15)]',
      'transition-all duration-300',
      hoverGlow && [
        'group-hover/glass:border-sky-300/80 dark:group-hover/glass:border-sky-500/40',
        'group-hover/glass:shadow-[0_16px_45px_rgba(56,189,248,0.22),inset_0_1px_2px_0_rgba(255,255,255,0.9)]',
        'dark:group-hover/glass:shadow-[0_16px_45px_rgba(56,189,248,0.25),inset_0_1px_2px_0_rgba(255,255,255,0.25)]',
      ],
    ]}
  >
    <!-- Surface tension sheen reflection (top-down micro specular gradient) -->
    <span
      class="pointer-events-none absolute inset-0 bg-gradient-to-b from-white/15 via-white/[0.02] to-transparent dark:from-white/5 dark:via-transparent dark:to-transparent"
    ></span>
  </span>

  <!-- Foreground Content Isolation Layer: keeps text and children 100% sharp -->
  <div class:list={['glass__content relative z-10 w-full', contentClass]}>
    <slot />
  </div>
</Component>
