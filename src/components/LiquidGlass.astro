---
// Authentic Liquid Glass Component (Ported from rdev/liquid-glass-react architecture per ADR 0005 & ADR 0007)
// Decouples the optical background warp layer (.glass__warp) from foreground child content (.glass__content).

interface Props {
  as?: 'div' | 'section' | 'article' | 'nav';
  class?: string;
  contentClass?: string;
  hoverGlow?: boolean;
  pill?: boolean;
  id?: string;
  'data-case-study-meta'?: string;
}

const {
  as: Component = 'div',
  class: className = '',
  contentClass = '',
  hoverGlow = false,
  pill = false,
  ...rest
} = Astro.props;
---

<Component
  class:list={[
    'relative isolate group/glass',
    pill ? 'rounded-full' : 'rounded-2xl',
    className,
  ]}
  {...rest}
>
  <!-- Optical Background Layer: pills receive liquid refraction filter, cards receive crystal backdrop blur -->
  <span
    aria-hidden="true"
    class:list={[
      'pointer-events-none absolute inset-0 -z-10 overflow-hidden',
      pill
        ? 'glass__warp rounded-full'
        : 'glass-card rounded-2xl',
      // Authentic zero-tint transparent base (100% optical refraction without milky acrylic wash)
      'bg-transparent',
      // Specular rim border
      'border border-white/50 dark:border-white/15',
      // Official rdev physical floating elevation shadow + specular bevel inset
      'shadow-[0_12px_40px_rgba(0,0,0,0.18),inset_0_1px_1px_0_rgba(255,255,255,0.8)]',
      'dark:shadow-[0_16px_50px_rgba(0,0,0,0.55),inset_0_1px_1px_0_rgba(255,255,255,0.15)]',
      'transition-all duration-300',
      hoverGlow && [
        'group-hover/glass:border-sky-300/80 dark:group-hover/glass:border-sky-500/40',
        'group-hover/glass:shadow-[0_16px_45px_rgba(56,189,248,0.22),inset_0_1px_2px_0_rgba(255,255,255,0.9)]',
        'dark:group-hover/glass:shadow-[0_16px_45px_rgba(56,189,248,0.25),inset_0_1px_2px_0_rgba(255,255,255,0.25)]',
      ],
    ]}
  >
    <!-- Surface tension sheen reflection (top-down micro specular gradient) -->
    <span
      class="pointer-events-none absolute inset-0 bg-gradient-to-b from-white/15 via-white/[0.02] to-transparent dark:from-white/5 dark:via-transparent dark:to-transparent"
    ></span>
  </span>

  <!-- Foreground Content Isolation Layer: keeps text and children 100% sharp -->
  <div class:list={['glass__content relative z-10 w-full', contentClass]}>
    <slot />
  </div>
</Component>
