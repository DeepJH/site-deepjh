---
// Authentic Liquid Glass Component (Ported from rdev/liquid-glass-react architecture per ADR 0005)
// Decouples the optical background warp layer (.glass-warp) from foreground child content (.glass__content).

interface Props {
  as?: 'div' | 'section' | 'article' | 'nav';
  class?: string;
  contentClass?: string;
  hoverGlow?: boolean;
  pill?: boolean;
  id?: string;
  'data-case-study-meta'?: string;
}

const {
  as: Component = 'div',
  class: className = '',
  contentClass = '',
  hoverGlow = false,
  pill = false,
  ...rest
} = Astro.props;
---

<Component
  class:list={[
    'relative isolate group/glass',
    pill ? 'rounded-full' : 'rounded-2xl',
    className,
  ]}
  {...rest}
>
  <!-- Optical Background Layer: pills receive liquid refraction filter, cards receive crystal backdrop blur -->
  <span
    aria-hidden="true"
    class:list={[
      'pointer-events-none absolute inset-0 -z-10 overflow-hidden',
      pill
        ? 'glass__warp glass-warp rounded-full'
        : 'rounded-2xl backdrop-blur-[4.5px] saturate-[140%]',
      // Crystalline high-transmittance tint (~88% transmittance, zero acrylic opacity)
      'bg-white/12 dark:bg-zinc-900/18',
      // Specular rim border
      'border border-white/60 dark:border-white/15',
      // Physical glass bevel inset highlight + soft ambient elevation shadow
      'shadow-[inset_0_1px_1px_0_rgba(255,255,255,0.85),inset_0_-1px_1px_0_rgba(0,0,0,0.02),0_4px_20px_0_rgba(0,0,0,0.03)]',
      'dark:shadow-[inset_0_1px_1px_0_rgba(255,255,255,0.15),inset_0_-1px_1px_0_rgba(0,0,0,0.3),0_4px_20px_0_rgba(0,0,0,0.25)]',
      'transition-all duration-300',
      hoverGlow && [
        'group-hover/glass:border-sky-300/80 dark:group-hover/glass:border-sky-500/40',
        'group-hover/glass:shadow-[inset_0_1px_2px_0_rgba(255,255,255,0.9),0_8px_24px_0_rgba(56,189,248,0.16)]',
        'dark:group-hover/glass:shadow-[inset_0_1px_2px_0_rgba(255,255,255,0.25),0_8px_24px_0_rgba(56,189,248,0.2)]',
      ],
    ]}
  >
    <!-- Surface tension sheen reflection (top-down micro specular gradient) -->
    <span
      class="pointer-events-none absolute inset-0 bg-gradient-to-b from-white/20 via-white/5 to-transparent dark:from-white/5 dark:via-transparent dark:to-transparent"
    ></span>
  </span>

  <!-- Foreground Content Isolation Layer: keeps text and children 100% sharp -->
  <div class:list={['glass__content relative z-10 w-full', contentClass]}>
    <slot />
  </div>
</Component>
