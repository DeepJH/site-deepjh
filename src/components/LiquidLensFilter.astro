---
// Zero-runtime SVG Displacement Filter providing optical lens refraction distortion on hover per ADR 0005.
---

<svg class="pointer-events-none fixed -top-[9999px] -left-[9999px] h-0 w-0" aria-hidden="true">
  <defs>
    <filter id="liquid-lens-distortion" x="-10%" y="-10%" width="120%" height="120%">
      <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" result="noise" />
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="3.5" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </defs>
</svg>
