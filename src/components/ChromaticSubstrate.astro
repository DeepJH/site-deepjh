---
// Chromatic Substrate: Ambient radial pastel gradient glows that provide optical refraction for Liquid Glass.
---

<div
  data-chromatic-substrate="true"
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 -z-10 overflow-hidden transition-opacity duration-700 select-none"
>
  <!-- Top-left cyan/sky glow -->
  <div
    class="absolute -top-32 -left-32 h-[500px] w-[500px] rounded-full bg-gradient-to-br from-sky-400/30 via-teal-300/18 to-transparent blur-3xl dark:from-cyan-900/25 dark:via-sky-950/20"
  ></div>

  <!-- Top-right violet/rose glow -->
  <div
    class="absolute -top-24 right-[-10%] h-[550px] w-[550px] rounded-full bg-gradient-to-bl from-purple-400/30 via-rose-300/18 to-transparent blur-3xl dark:from-purple-950/30 dark:via-fuchsia-950/20"
  ></div>

  <!-- Center subtle amber glow -->
  <div
    class="absolute top-1/3 left-1/2 -translate-x-1/2 h-[450px] w-[600px] rounded-full bg-gradient-to-r from-amber-300/18 via-rose-200/12 to-transparent blur-3xl dark:from-amber-950/15 dark:via-rose-950/10"
  ></div>

  <!-- Bottom-center indigo/slate glow -->
  <div
    class="absolute -bottom-40 left-1/4 h-[600px] w-[600px] rounded-full bg-gradient-to-t from-indigo-300/24 via-sky-200/18 to-transparent blur-3xl dark:from-indigo-950/25 dark:via-slate-900/20"
  ></div>
</div>
