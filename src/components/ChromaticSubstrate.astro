---
// Chromatic Substrate: Ambient multi-point fluid gradients providing rich optical refraction for Liquid Glass.
// Tuned to 70% intensity per ADR 0008: Cyan #00D2FF, Deep Violet #7928CA, Sunset Amber #FF7700, Electric Rose #FF0080.
---

<div
  data-chromatic-substrate="true"
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 -z-10 overflow-hidden transition-opacity duration-700 select-none"
>
  <!-- Top-left vibrant cyan mesh -->
  <div
    class="absolute -top-24 -left-20 h-[600px] w-[600px] rounded-full bg-gradient-to-br from-[#00D2FF]/60 via-[#00D2FF]/52 to-transparent blur-3xl dark:from-[#00D2FF]/45 dark:via-[#7928CA]/35"
  ></div>

  <!-- Top-center deep violet mesh (directly behind sticky header scroll path) -->
  <div
    class="absolute -top-32 left-1/3 h-[550px] w-[550px] rounded-full bg-gradient-to-b from-[#7928CA]/56 via-[#FF0080]/50 to-transparent blur-3xl dark:from-[#7928CA]/42 dark:via-[#FF0080]/35"
  ></div>

  <!-- Top-right radiant sunset amber mesh -->
  <div
    class="absolute -top-20 -right-24 h-[650px] w-[650px] rounded-full bg-gradient-to-bl from-[#FF7700]/60 via-[#FF7700]/52 to-transparent blur-3xl dark:from-[#FF7700]/45 dark:via-[#FF0080]/35"
  ></div>

  <!-- Mid-page electric rose mesh -->
  <div
    class="absolute top-1/2 -left-28 -translate-y-1/2 h-[700px] w-[650px] rounded-full bg-gradient-to-r from-[#FF0080]/56 via-[#7928CA]/50 to-transparent blur-3xl dark:from-[#FF0080]/42 dark:via-[#7928CA]/35"
  ></div>

  <!-- Bottom-center deep violet / cyan foundation mesh -->
  <div
    class="absolute -bottom-36 left-1/2 -translate-x-1/2 h-[750px] w-[900px] rounded-full bg-gradient-to-t from-[#7928CA]/60 via-[#00D2FF]/52 to-transparent blur-3xl dark:from-[#7928CA]/45 dark:via-[#00D2FF]/35"
  ></div>
</div>
