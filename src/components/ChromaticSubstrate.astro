---
// Chromatic Substrate: Ambient radial pastel gradient glows that provide optical refraction for Liquid Glass.
---

<div
  data-chromatic-substrate="true"
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 -z-10 overflow-hidden transition-opacity duration-700 select-none"
>
  <!-- Top-left cyan/sky glow -->
  <div
    class="absolute -top-32 -left-32 h-[500px] w-[500px] rounded-full bg-gradient-to-br from-sky-400/36 via-teal-300/22 to-transparent blur-3xl dark:from-cyan-900/30 dark:via-sky-950/25"
  ></div>

  <!-- Top-right violet/rose glow -->
  <div
    class="absolute -top-24 right-[-10%] h-[550px] w-[550px] rounded-full bg-gradient-to-bl from-purple-400/36 via-rose-300/22 to-transparent blur-3xl dark:from-purple-950/35 dark:via-fuchsia-950/25"
  ></div>

  <!-- Center subtle amber glow -->
  <div
    class="absolute top-1/3 left-1/2 -translate-x-1/2 h-[450px] w-[600px] rounded-full bg-gradient-to-r from-amber-300/22 via-rose-200/15 to-transparent blur-3xl dark:from-amber-950/20 dark:via-rose-950/15"
  ></div>

  <!-- Bottom-center indigo/slate glow -->
  <div
    class="absolute -bottom-40 left-1/4 h-[600px] w-[600px] rounded-full bg-gradient-to-t from-indigo-300/28 via-sky-200/22 to-transparent blur-3xl dark:from-indigo-950/30 dark:via-slate-900/25"
  ></div>
</div>
