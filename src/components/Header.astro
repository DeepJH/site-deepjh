---
import ThemeSwitcher from './ThemeSwitcher.astro';
import LiquidGlass from './LiquidGlass.astro';
import { isZhLocale, getBilingualTarget } from '../utils/locale';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const isZh = isZhLocale(currentPath);
const targetLangPath = getBilingualTarget(currentPath, isZh);

const navItems = isZh
  ? [
      { href: '/zh/projects', label: '项目' },
      { href: '/zh/posts', label: '文章' },
    ]
  : [
      { href: '/projects', label: 'Projects' },
      { href: '/posts', label: 'Posts' },
    ];

const contactLinks = [
  { href: 'https://github.com/DeepJH', label: 'GitHub', external: true },
  { href: 'mailto:deepjhshenjing@gmail.com', label: 'Email', external: false },
  { href: '/rss.xml', label: 'RSS', external: false },
];
---

<header class="sticky top-4 z-40 mx-auto w-full max-w-5xl px-4 sm:px-6">
  <LiquidGlass pill class="h-14" contentClass="flex h-14 items-center justify-between px-5 sm:px-6">
    <!-- Brand / Home Link -->
    <a
      href={isZh ? '/zh' : '/'}
      class="group flex items-center gap-2.5 text-base font-semibold tracking-tight text-zinc-900 transition-colors hover:text-sky-600 dark:text-zinc-100 dark:hover:text-sky-400"
    >
      <img
        src="/avatar.png"
        alt="DeepJH Avatar"
        class="h-7 w-7 rounded-full object-cover ring-2 ring-sky-500/30 transition-transform group-hover:scale-110 shadow-sm"
      />
      <span>DeepJH</span>
    </a>

    <!-- Nav Items, Language Switcher, Contact Links & Theme Switcher -->
    <div class="flex items-center gap-2 sm:gap-3">
      <nav class="flex items-center gap-1 sm:gap-1.5">
        {
          navItems.map((item) => {
            const isActive =
              item.href === '/' || item.href === '/zh'
                ? currentPath === item.href
                : currentPath.startsWith(item.href);
            return (
              <a
                href={item.href}
                class:list={[
                  'rounded-full px-3 py-1.5 text-sm font-medium transition-colors',
                  isActive
                    ? 'bg-zinc-100/90 text-zinc-900 dark:bg-zinc-800/90 dark:text-zinc-100'
                    : 'text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100/60 dark:text-zinc-400 dark:hover:text-zinc-100 dark:hover:bg-zinc-800/60',
                ]}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>

      <!-- Language Switcher Pill -->
      <div
        class="flex items-center rounded-full border border-zinc-200/80 bg-zinc-100/70 p-0.5 text-xs font-medium dark:border-zinc-700/80 dark:bg-zinc-800/70"
        data-lang-switcher="true"
      >
        <a
          href={isZh ? targetLangPath : currentPath}
          class:list={[
            'rounded-full px-2 py-0.5 transition-all text-[11px]',
            !isZh
              ? 'bg-white font-bold text-zinc-900 shadow-sm dark:bg-zinc-900 dark:text-zinc-100'
              : 'text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100',
          ]}
          aria-label="Switch to English"
        >
          EN
        </a>
        <a
          href={isZh ? currentPath : targetLangPath}
          class:list={[
            'rounded-full px-2 py-0.5 transition-all text-[11px]',
            isZh
              ? 'bg-white font-bold text-zinc-900 shadow-sm dark:bg-zinc-900 dark:text-zinc-100'
              : 'text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100',
          ]}
          aria-label="切换至中文"
        >
          中文
        </a>
      </div>

      <div class="hidden h-4 w-px bg-zinc-200 dark:bg-zinc-700/80 sm:block"></div>

      <!-- Quick Contact / RSS Links in Header -->
      <div class="hidden items-center gap-2 sm:flex">
        {
          contactLinks.map((link) => (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              class="rounded-full px-2 py-1 text-xs font-medium text-zinc-500 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
            >
              {link.label}
            </a>
          ))
        }
      </div>

      <div class="h-4 w-px bg-zinc-200 dark:bg-zinc-700/80"></div>

      <ThemeSwitcher />
    </div>
  </LiquidGlass>
</header>
