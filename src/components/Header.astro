---
import ThemeSwitcher from './ThemeSwitcher.astro';
import LiquidGlass from './LiquidGlass.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { href: '/projects', label: 'Projects' },
  { href: '/posts', label: 'Posts' },
];

const contactLinks = [
  { href: 'https://github.com/DeepJH', label: 'GitHub', external: true },
  { href: 'https://linkedin.com/in/deepjh', label: 'LinkedIn', external: true },
  { href: 'mailto:contact@deepjh.com', label: 'Email', external: false },
  { href: '/rss.xml', label: 'RSS', external: false },
];
---

<header class="sticky top-4 z-40 mx-auto w-full max-w-5xl px-4 sm:px-6">
  <LiquidGlass class="flex h-14 items-center justify-between px-4 sm:px-6">
    <!-- Brand / Home Link -->
    <a
      href="/"
      class="group flex items-center gap-2 text-base font-semibold tracking-tight text-zinc-900 transition-colors hover:text-sky-600 dark:text-zinc-100 dark:hover:text-sky-400"
    >
      <span
        class="inline-block h-2.5 w-2.5 rounded-full bg-gradient-to-tr from-sky-400 to-indigo-500 shadow-sm transition-transform group-hover:scale-125"
      ></span>
      <span>DeepJH</span>
    </a>

    <!-- Nav Items, Contact Links & Theme Switcher -->
    <div class="flex items-center gap-2 sm:gap-4">
      <nav class="flex items-center gap-1 sm:gap-2">
        {
          navItems.map((item) => {
            const isActive =
              item.href === '/'
                ? currentPath === '/'
                : currentPath.startsWith(item.href);
            return (
              <a
                href={item.href}
                class:list={[
                  'rounded-lg px-2.5 py-1.5 text-sm font-medium transition-colors',
                  isActive
                    ? 'bg-zinc-100/90 text-zinc-900 dark:bg-zinc-800/90 dark:text-zinc-100'
                    : 'text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100/60 dark:text-zinc-400 dark:hover:text-zinc-100 dark:hover:bg-zinc-800/60',
                ]}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>

      <div class="hidden h-4 w-px bg-zinc-200 dark:bg-zinc-700/80 sm:block"></div>

      <!-- Quick Contact / RSS Links in Header -->
      <div class="hidden items-center gap-2 sm:flex">
        {
          contactLinks.map((link) => (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              class="rounded-lg px-2 py-1 text-xs font-medium text-zinc-500 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
            >
              {link.label}
            </a>
          ))
        }
      </div>

      <div class="h-4 w-px bg-zinc-200 dark:bg-zinc-700/80"></div>

      <ThemeSwitcher />
    </div>
  </LiquidGlass>
</header>
